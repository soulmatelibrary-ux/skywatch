# =====================================================
# SkyWatch 환경설정 파일
# 이 파일을 복사하여 .env 로 저장한 뒤 값을 채워주세요
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)
# .env 는 git 에 올리지 않는다 (비밀번호가 들어감)
# =====================================================

# ----- PostgreSQL 연결 -----
# SkyWatch 메인 DB (일지, 사용자, 카드 등) — PostgreSQL 17 + pgvector
DATABASE_URL=postgresql://postgres:비밀번호@localhost:5432/skywatch

# SkyNet 크롤링 DB (문서 검색, 게시판). 없으면 비워 둔다 (SkyNet 메뉴만 비어 보임)
SKYNET_DATABASE_URL=

# ----- 보안 -----
# 64자 이상 임의 문자열. 만들기: python -c "import secrets; print(secrets.token_urlsafe(64))"
# (현재 세션은 DB 토큰 방식이라 직접 쓰이지 않지만 값은 채워 둔다)
SECRET_KEY=여기에_64자_이상의_랜덤_문자열_입력

# 세션 유지 시간 (시간 단위, 기본 16시간)
SESSION_EXPIRE_HOURS=16

# 화면 주소 (쉼표로 구분). 다른 PC 에서 IP 로 접속하면 그 주소도 추가
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ----- 파일 경로 -----
# 첨부파일 저장 디렉토리 (상대경로는 backend 기준)
UPLOAD_DIR=./uploads
# DB 백업 파일 저장 디렉토리
BACKUP_DIR=./backups

# 임베딩 모델은 backend/models/kure-v1 고정 (app/services/vector_model.py). 아래 값은 쓰이지 않는 옛 설정
# EMBEDDING_MODEL_PATH=./models/kure-v1

# ----- PostgreSQL 도구 경로 (DB 백업/복원용) -----
# 설치된 PostgreSQL 버전에 맞춘다. PATH 에 있으면 pg_dump / psql 만 적어도 된다
PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe
PSQL_PATH=C:/Program Files/PostgreSQL/17/bin/psql.exe

# ----- SkyNet 연동 -----
# SkyNet Flask 서버 주소 (크롤링 제어용, 기본값 유지)
SKYNET_API_URL=http://localhost:5000

# 게시판 원문 열기 URL (선택사항). atcl_id 가 뒤에 &atclId=xxx 형태로 붙는다
# 예: http://게시판서버/board/view?boardId=xxx
BOARD_DIRECT_URL=

# 마이그레이션 실패 시 서버를 멈출지 (기본 false = 경고만)
# FAIL_ON_MIGRATION_ERROR=false
